# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# Exact immutable Vercel Preview origin used by the Staging legal register only
PREVIEW_LEGAL_DOCUMENT_ORIGIN=

# Vercel Web Analytics Admin reporting (server-only; Production rollout only)
VERCEL_ANALYTICS_ACCESS_TOKEN=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_PROJECT_ID=

# Transactional email (server-only; disabled by default)
RESEND_API_KEY=replace_with_resend_api_key
TRANSACTIONAL_EMAIL_FROM=replace_with_verified_transactional_sender
TRANSACTIONAL_EMAIL_REPLY_TO=replace_with_monitored_operations_mailbox
TRANSACTIONAL_EMAIL_APP_ORIGIN=https://replace-with-ironclad-origin.example
TRANSACTIONAL_EMAIL_MODE=disabled
TRANSACTIONAL_EMAIL_ALLOWED_CLERK_USER_IDS=[]
TRANSACTIONAL_EMAIL_WORKER_SECRET=replace_with_worker_bearer_secret

# Steam OpenID (server-only exact HTTPS origin, without a path)
STEAM_OPENID_ORIGIN=https://replace-with-ironclad-origin.example

# Steam Web API (server-only user authentication key)
STEAM_WEB_API_KEY=replace_with_steam_web_api_key
