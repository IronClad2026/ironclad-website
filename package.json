    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "web-push": "^3.6.7"
